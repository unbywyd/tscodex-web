# Скопируйте в .env и заполните. .env в git не попадает (см. корневой .gitignore).
# Репозиторий публичный — реальные значения сюда не вписывать НИКОГДА.

NODE_ENV=development
PORT=3300
HOST=0.0.0.0

# Postgres. Локально — своя база, на сервере — из /etc/tscodex/services.env.
# На боевом сервере Postgres слушает 55432, а не 5432.
DATABASE_URL=postgres://tscodex:PASSWORD@127.0.0.1:5432/tscodex_services

# Через запятую, без пробелов. '*' здесь недопустим: прокси тратит наши деньги.
CORS_ORIGIN=http://localhost:3000

# Мастер-ключ прокси, минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=

# Ключи провайдеров — только на сервере, в desktop-сборки не попадают.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

APP_URL=http://localhost:3000
